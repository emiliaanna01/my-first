# Copy to .env and fill in what you use. Every line is optional:
# a panel without its key shows sample data and tells you what to add.

# Google Calendar: Settings > (your calendar) > Integrate calendar > "Secret address in iCal format".
# Several calendars: separate with ";" and optionally name them, e.g.
# CALENDAR_ICS_URLS="Work=https://calendar.google.com/calendar/ical/.../basic.ics; Personal=https://calendar.google.com/calendar/ical/.../basic.ics"
CALENDAR_ICS_URLS=

# Notion: create an internal integration at https://www.notion.so/profile/integrations,
# then open your tasks database > ... > Connections > add the integration.
NOTION_TOKEN=
# The 32-character ID from the database URL (notion.so/<workspace>/<ID>?v=...)
NOTION_DATABASE_ID=

# X API bearer token (reading posts needs a paid X API plan). Leave empty to use
# an embedded timeline or RSS sources instead.
X_BEARER_TOKEN=

# PORT=4300
# HOST=127.0.0.1   # keep it on localhost: the server can write to your Notion
