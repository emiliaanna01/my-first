{
  "mcpServers": {
    "context7": {
      "command": "npx",
      "args": ["-y", "@upstash/context7-mcp@latest"]
    },
    "playwright": {
      "command": "bash",
      "args": ["web-design/bin/playwright-mcp.sh"]
    },
    "chrome-devtools": {
      "command": "bash",
      "args": ["web-design/bin/chrome-devtools-mcp.sh"]
    },
    "shadcn": {
      "command": "npx",
      "args": ["-y", "shadcn@latest", "mcp"]
    }
  }
}
