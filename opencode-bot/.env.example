# Copy this file to .env (same folder) and fill in your values. .env is never committed.
# Bot token from @BotFather. Use a separate bot from Path Abroad: only one program can poll a bot at a time.
TELEGRAM_BOT_TOKEN=paste-your-opencode-bot-token
# Your own chat id. Only this chat can control opencode, so keep it to yourself.
TELEGRAM_CHAT_ID=paste-your-chat-id
# The folder opencode works in, e.g. C:\Users\you\projects\my-app
OPENCODE_PROJECT_DIR=
# Optional: model as provider/model; empty uses opencode's own default
OPENCODE_MODEL=
# Tools that must ask you first (buttons in Telegram). Empty = whatever opencode allows.
OPENCODE_ASK=bash,edit
# Optional: voice transcription. tiny/base/small/medium/large-v3; language code like en, empty = auto-detect
WHISPER_MODEL=small
WHISPER_LANGUAGE=
